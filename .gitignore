# Local Python virtualenv — not part of the site
.venv/

# Separate venv for the AudioGen sound-generation tool. Kept apart from .venv
# on purpose: audiocraft pins old torch/numpy and would break the playwright,
# pillow and edge-tts tooling the whole build depends on. Python 3.12, because
# torch has no 3.14 wheels. Rebuild with tools/gen-sound.py --setup.
.venv-audio/

# Separate venv for MOSS-SoundEffect (Apache 2.0, 48 kHz). Its own environment
# because it pins torch 2.9+cu128 and numpy 1.26 against a checkout that lives
# outside this repo at ../MOSS-TTS. Rebuild: see tools/gen-sound.py.
.venv-moss/
__pycache__/
*.pyc

# IDE
.idea/
.vscode/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Voice comparison samples, not part of the site
voice-samples/

# Per-beat narration cache (scene mp3s are committed, these are not)
.narrate-cache/

# Installed agent skills (per-machine, not part of the site)
.agents/

# Visual QA output
shots/

# Agent skills installed per-machine via `npx skills add`
.claude/skills/

# Raw Natural Earth / Overpass downloads. 165 MB of source that the build
# turns into the ~4 MB under assets/geo and content/<pack>/geo that actually
# ships. Re-fetch with tools/build-basemap.py and tools/fetch-detail.py.
assets/geo/_src/

# Generated sound candidates, waiting to be listened to. Top level and in
# plain English on purpose — they get opened by hand for days, and hunting for
# them under content/<pack>/sound/_candidates or in AppData was hopeless.
# Only what `gen-sound.py --accept` promotes into content/<pack>/sound/ is
# committed, and that carries its licence and prompt in sound.json.
# The README inside is kept, the audio is not.
sound-candidates/*
!sound-candidates/README.md

# Git Bash crash dumps
*.stackdump

# Generated image candidates, waiting to be looked at. Top level and in plain
# English for the same reason sound-candidates is: they get opened by hand.
# Only what gen-image.py --accept promotes into content/<pack>/media/ is
# committed, and that carries its licence, prompt and claims in media.json.
image-candidates/

# Downloaded music/sound source packs. The CC0 loop bundle is 71 MB of source
# that nothing in the build reads — a bed is generated by tools/gen-music.py
# and lives in content/<pack>/sound/. Keep the zip if you want to browse it;
# it is not part of the site.
music-loop-bundle-*.zip
