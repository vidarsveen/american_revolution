{
  "version": 1,
  "note": "The cue vocabulary. THE source of truth: engine/stage.js binds handlers to it and refuses to boot with a mismatch, and tools/check-script.py validates chapters against it. This file exists because the list used to be hand-copied between those two, so adding a verb to one and not the other made a typo in a chapter silently do nothing.",
  "refTypes": {
    "place": "chapter.places",
    "route": "chapter.routes",
    "person": "pack.people",
    "media": "pack.media",
    "quote": "chapter.quotes",
    "sound": "pack.sound",
    "region": "chapter.regions"
  },
  "verbs": {
    "map.flyTo": {
      "summary": {
        "no": "Fly kameraet til et sted",
        "en": "Fly the camera to a place"
      },
      "args": {
        "to": {
          "type": "place",
          "required": true
        },
        "zoom": {
          "type": "number",
          "min": 1,
          "max": 18
        },
        "over": {
          "type": "seconds"
        }
      }
    },
    "map.fitRoute": {
      "summary": {
        "no": "Ramme inn en hel rute",
        "en": "Frame a whole route"
      },
      "args": {
        "id": {
          "type": "route",
          "required": true
        },
        "over": {
          "type": "seconds"
        }
      }
    },
    "map.fitPlaces": {
      "summary": {
        "no": "Ramme inn flere steder",
        "en": "Frame several places"
      },
      "args": {
        "places": {
          "type": "place[]",
          "required": true
        },
        "over": {
          "type": "seconds"
        }
      }
    },
    "map.time": {
      "summary": {
        "no": "Sett klokkeslettet på kartet",
        "en": "Set the clock on the map"
      },
      "note": "value: null clears the clock — the epilogue steps outside the day.",
      "args": {
        "value": {
          "type": "i18n"
        }
      }
    },
    "map.mood": {
      "summary": {
        "no": "Tid på døgnet",
        "en": "Time of day"
      },
      "args": {
        "value": {
          "type": "enum",
          "values": [
            "day",
            "dawn",
            "dusk",
            "night",
            "storm"
          ],
          "required": true
        }
      }
    },
    "map.flash": {
      "summary": {
        "no": "Et skudd går av",
        "en": "A shot goes off"
      },
      "args": {}
    },
    "region.show": {
      "summary": {
        "no": "Vis et navngitt område",
        "en": "Show a named region"
      },
      "note": "Names resolve against the file the chapter declares in `regions`.",
      "args": {
        "names": {
          "type": "region[]",
          "required": true
        },
        "side": {
          "type": "faction"
        },
        "label": {
          "type": "boolean",
          "default": true
        },
        "over": {
          "type": "seconds"
        }
      }
    },
    "region.clear": {
      "summary": {
        "no": "Fjern områdene",
        "en": "Clear the regions"
      },
      "args": {}
    },
    "border.set": {
      "summary": {
        "no": "Slå grenser av og på",
        "en": "Turn boundaries on and off"
      },
      "note": "0 country, 1 state/province. A pack decides what those mean.",
      "args": {
        "country": {
          "type": "boolean"
        },
        "state": {
          "type": "boolean"
        }
      }
    },
    "route.draw": {
      "summary": {
        "no": "En marsj tegner seg selv",
        "en": "A march draws itself"
      },
      "args": {
        "id": {
          "type": "route",
          "required": true
        },
        "over": {
          "type": "seconds"
        },
        "fit": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "route.clear": {
      "summary": {
        "no": "Fjern alle ruter",
        "en": "Clear every route"
      },
      "args": {}
    },
    "marker.show": {
      "summary": {
        "no": "En navngitt nål",
        "en": "A named pin"
      },
      "args": {
        "at": {
          "type": "place",
          "required": true
        },
        "label": {
          "type": "i18n"
        },
        "side": {
          "type": "faction"
        }
      }
    },
    "marker.hide": {
      "summary": {
        "no": "Fjern én nål",
        "en": "Remove one pin"
      },
      "args": {
        "at": {
          "type": "place",
          "required": true
        }
      }
    },
    "marker.clear": {
      "summary": {
        "no": "Fjern alle nåler",
        "en": "Clear every pin"
      },
      "args": {}
    },
    "place.highlight": {
      "summary": {
        "no": "Peke på kartet mens du snakker",
        "en": "Point at the map while you talk"
      },
      "args": {
        "at": {
          "type": "place",
          "required": true
        },
        "side": {
          "type": "faction"
        },
        "centre": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "place.clear": {
      "summary": {
        "no": "Fjern ringene",
        "en": "Clear the rings"
      },
      "args": {}
    },
    "converge": {
      "summary": {
        "no": "Styrker som kommer inn og møtes",
        "en": "Forces coming in and joining"
      },
      "args": {
        "from": {
          "type": "place[]",
          "required": true
        },
        "to": {
          "type": "place",
          "required": true
        },
        "side": {
          "type": "faction"
        },
        "strength": {
          "type": "number"
        },
        "over": {
          "type": "seconds"
        },
        "fit": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "portrait.show": {
      "summary": {
        "no": "Personen det snakkes om",
        "en": "The person being spoken about"
      },
      "args": {
        "id": {
          "type": "person",
          "required": true
        }
      }
    },
    "portrait.hide": {
      "summary": {
        "no": "Skjul portrettet",
        "en": "Hide the portrait"
      },
      "args": {}
    },
    "image.show": {
      "summary": {
        "no": "Et bilde i full bredde",
        "en": "A full-bleed image"
      },
      "args": {
        "id": {
          "type": "media",
          "required": true
        }
      }
    },
    "image.hide": {
      "summary": {
        "no": "Skjul bildet",
        "en": "Hide the image"
      },
      "args": {}
    },
    "quote.show": {
      "summary": {
        "no": "Et sitat fra en kilde",
        "en": "A quote from a source"
      },
      "args": {
        "id": {
          "type": "quote",
          "required": true
        }
      }
    },
    "quote.hide": {
      "summary": {
        "no": "Skjul sitatet",
        "en": "Hide the quote"
      },
      "args": {}
    },
    "stat.show": {
      "summary": {
        "no": "Et tall som teller",
        "en": "A number that matters"
      },
      "args": {
        "value": {
          "type": "string",
          "required": true
        },
        "label": {
          "type": "i18n"
        },
        "side": {
          "type": "faction"
        }
      }
    },
    "stat.clear": {
      "summary": {
        "no": "Fjern tallene",
        "en": "Clear the numbers"
      },
      "args": {}
    },
    "caption.note": {
      "summary": {
        "no": "En kort merknad under teksten",
        "en": "A short note under the caption"
      },
      "args": {
        "value": {
          "type": "i18n",
          "required": true
        }
      }
    },
    "hold": {
      "summary": {
        "no": "Hold bildet",
        "en": "Hold the picture"
      },
      "args": {},
      "handledBy": "player"
    },
    "pause": {
      "summary": {
        "no": "Vent på et trykk",
        "en": "Wait for a tap"
      },
      "args": {},
      "handledBy": "player"
    }
  }
}
